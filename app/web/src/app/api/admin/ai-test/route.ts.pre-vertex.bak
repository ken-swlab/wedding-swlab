import { NextResponse } from "next/server";
import { admin } from "@/lib/firebase-admin";
import { tagDef } from "@/config/tags";
import { themeDef } from "@/config/episodes";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";
export const maxDuration = 60;

const MAX_HISTORY = 20;
const MAX_EPISODES = 24;
const MAX_BASE_PROMPT = 4000;
const MAX_MESSAGE = 1000;
const GEMINI_TIMEOUT_MS = 25_000;

type Turn = { role: "user" | "model"; text: string };

type ContextEpisode = {
  id: string;
  title: string;
  period: string;
  theme: string;
  content: string;
  /** targetUids にこのゲストが含まれている（本人についての話） */
  isPersonal: boolean;
};

function fail(message: string, status: number, extra?: Record<string, unknown>) {
  return NextResponse.json({ ok: false, message, ...extra }, { status });
}

function geminiModel(): string {
  return process.env.GEMINI_MODEL ?? "gemini-1.5-flash";
}

export async function POST(req: Request) {
  try {
    return await handle(req);
  } catch (e) {
    console.error("[ai-test]", e);
    return fail(e instanceof Error ? e.message : "サーバー内部エラー", 500);
  }
}

async function handle(req: Request) {
  const { auth, db } = admin();

  // ---- 管理者のみ -----------------------------------------
  const header = req.headers.get("authorization") ?? "";
  const idToken = header.startsWith("Bearer ") ? header.slice(7).trim() : "";
  if (!idToken) return fail("認証情報がありません", 401);
  try {
    const decoded = await auth.verifyIdToken(idToken, true);
    if (decoded.admin !== true) return fail("管理者権限が必要です", 403);
  } catch {
    return fail("ログインし直してください", 401);
  }

  let body: Record<string, unknown>;
  try {
    body = (await req.json()) as Record<string, unknown>;
  } catch {
    return fail("リクエストが不正です", 400);
  }

  const guestUid = typeof body.guestUid === "string" ? body.guestUid.trim() : "";
  if (!guestUid) return fail("ゲストを選択してください", 400);

  const preview = body.preview === true;
  const message = typeof body.message === "string" ? body.message.trim() : "";
  if (!preview && !message) return fail("メッセージを入力してください", 400);
  if (message.length > MAX_MESSAGE) return fail("メッセージが長すぎます", 400);

  const basePrompt = typeof body.basePrompt === "string"
    ? body.basePrompt.trim().slice(0, MAX_BASE_PROMPT)
    : "";

  // ---- 1. ゲストの情報 -------------------------------------
  const [guestSnap, adminSnap] = await Promise.all([
    db.collection("guests").doc(guestUid).get(),
    db.collection("guestAdmin").doc(guestUid).get(),
  ]);
  if (!guestSnap.exists) return fail("ゲストが見つかりません", 404);

  const nickname = (guestSnap.get("nickname") as string) || "";
  const realName = (guestSnap.get("realName") as string) || "";
  const displayName = (guestSnap.get("displayName") as string) || "";
  const guestTags = Array.isArray(guestSnap.get("tags")) ? (guestSnap.get("tags") as string[]) : [];
  const aiMemo = (adminSnap.get("aiMemo") as string) || "";

  const callName = nickname || displayName || realName || "ゲスト";

  // ---- 2. エピソードの取得 ---------------------------------
  //
  // ★visibleToTags との交差で機械的に絞る★
  //   targetUids との OR にはしない。
  //   「本人についての話」でも、見せてよい範囲外なら渡さない。
  //   targetUids は下で優先度に使う。
  //
  let episodes: ContextEpisode[] = [];
  if (guestTags.length > 0) {
    const snap = await db
      .collection("episodes")
      .where("status", "==", "approved")
      .where("visibleToTags", "array-contains-any", guestTags.slice(0, 30))
      .orderBy("createdAt", "desc")
      .limit(100)
      .get();

    episodes = snap.docs.map((d) => {
      const v = d.data();
      const targets = Array.isArray(v.targetUids) ? (v.targetUids as string[]) : [];
      return {
        id: d.id,
        title: (v.title as string) || "",
        period: (v.period as string) || "",
        theme: (v.theme as string) || "other",
        content: ((v.content as string) || (v.originalText as string) || "").slice(0, 1200),
        isPersonal: targets.includes(guestUid),
      };
    })
    // 本人についての話を先頭に寄せる
    .sort((a, b) => Number(b.isPersonal) - Number(a.isPersonal))
    .slice(0, MAX_EPISODES);
  }

  // ---- 3. システムプロンプトの組み立て ----------------------
  const tagLabels = guestTags.map((t) => tagDef(t).label).join("・") || "（なし）";

  const episodeBlock = episodes.length === 0
    ? "（まだエピソードがありません）"
    : episodes.map((e, i) => {
        const head = [
          `--- ${i + 1}. ${e.title || "（タイトルなし）"}`,
          e.period ? `（${e.period}）` : "",
          e.isPersonal ? `　★${callName}さん本人についての話★` : "",
        ].join("");
        return `${head}\n［お題: ${themeDef(e.theme).label}］\n${e.content}`;
      }).join("\n\n");

  // ★ここから下は編集させない★
  //   人格（basePrompt）はチューニング対象だが、
  //   「作り話をしない」「範囲外に触れない」は仕様であって好みではない。
  const systemInstruction = `${basePrompt || "あなたは新郎です。明るくフランクに話します。"}

━━━━━━━━━━━━━━━━━━━━
【いま話している相手】
・呼び名: ${callName}
${realName ? `・本名: ${realName}\n` : ""}・グループ: ${tagLabels}
${aiMemo ? `・新郎新婦のメモ: ${aiMemo}` : "・新郎新婦のメモ: （なし）"}

━━━━━━━━━━━━━━━━━━━━
【あなたが知っているエピソード】
※ここに書かれていることだけが、あなたの知識です。

${episodeBlock}

━━━━━━━━━━━━━━━━━━━━
【必ず守ること】
1. 上のエピソードに書かれていないことは、絶対に作り話をしない。
2. 知らないことを聞かれたら、正直に知らないと認めて
   「あっちにいる本人に聞いてよ！」と返す。ごまかさない。
3. ★上に載っていないゲストの話・個人情報には一切触れない。★
   名前を出してよいのは、上のエピソードに登場する人物だけ。
4. 返事は2〜3文、長くても120文字程度。披露宴の立ち話のテンポで。
5. 相手のことは「${callName}」と呼ぶ。
6. 新郎新婦のメモは、あなたの心構えとして使う。
   メモの内容そのものを相手に読み上げない。`;

  const debug = {
    callName,
    tagLabels,
    aiMemo,
    episodes: episodes.map((e) => ({
      id: e.id, title: e.title, period: e.period,
      theme: e.theme, isPersonal: e.isPersonal,
      content: e.content,
    })),
    systemInstruction,
    model: geminiModel(),
  };

  // プレビューだけなら Gemini を叩かない（API 消費を抑える）
  if (preview) {
    return NextResponse.json({ ok: true, preview: true, debug });
  }

  // ---- 4. Gemini を叩く ------------------------------------
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) return fail("GEMINI_API_KEY が設定されていません", 500);

  const rawHistory = Array.isArray(body.history) ? (body.history as unknown[]) : [];
  const history: Turn[] = rawHistory
    .filter((t): t is Turn =>
      typeof t === "object" && t !== null &&
      ((t as Turn).role === "user" || (t as Turn).role === "model") &&
      typeof (t as Turn).text === "string")
    .slice(-MAX_HISTORY);

  const contents = [
    ...history.map((t) => ({ role: t.role, parts: [{ text: t.text }] })),
    { role: "user", parts: [{ text: message }] },
  ];

  const url =
    `https://generativelanguage.googleapis.com/v1beta/models/${geminiModel()}:generateContent?key=${apiKey}`;

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), GEMINI_TIMEOUT_MS);

  let res: Response;
  try {
    res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      signal: controller.signal,
      cache: "no-store",
      body: JSON.stringify({
        systemInstruction: { parts: [{ text: systemInstruction }] },
        contents,
        generationConfig: {
          temperature: 0.9,
          topP: 0.95,
          maxOutputTokens: 400,
        },
        // 披露宴のいじり合いが安全フィルタで落ちないように緩める
        safetySettings: [
          "HARM_CATEGORY_HARASSMENT",
          "HARM_CATEGORY_HATE_SPEECH",
          "HARM_CATEGORY_SEXUALLY_EXPLICIT",
          "HARM_CATEGORY_DANGEROUS_CONTENT",
        ].map((category) => ({ category, threshold: "BLOCK_ONLY_HIGH" })),
      }),
    });
  } catch (e) {
    clearTimeout(timer);
    const aborted = (e as { name?: string }).name === "AbortError";
    return fail(aborted ? "Gemini の応答がタイムアウトしました" : "Gemini に接続できません", 504, { debug });
  }
  clearTimeout(timer);

  const raw = await res.text();
  let data: Record<string, unknown> | null = null;
  try {
    data = JSON.parse(raw) as Record<string, unknown>;
  } catch {
    data = null;
  }

  if (!res.ok) {
    // ★本文をそのまま返す★
    //   モデル名が使えない場合（404）など、原因が本文にしか書かれていない。
    const detail =
      (data?.error as { message?: string } | undefined)?.message ?? raw.slice(0, 400);
    return fail(`Gemini エラー (${res.status}): ${detail}`, 502, { debug });
  }

  const candidates = (data?.candidates ?? []) as Array<{
    content?: { parts?: Array<{ text?: string }> };
    finishReason?: string;
  }>;
  const text = (candidates[0]?.content?.parts ?? [])
    .map((p) => p.text ?? "")
    .join("")
    .trim();

  if (!text) {
    const blocked =
      (data?.promptFeedback as { blockReason?: string } | undefined)?.blockReason ??
      candidates[0]?.finishReason ??
      "不明";
    return fail(`応答が空でした（理由: ${blocked}）`, 502, { debug });
  }

  const usage = data?.usageMetadata as
    | { promptTokenCount?: number; candidatesTokenCount?: number }
    | undefined;

  return NextResponse.json({
    ok: true,
    text,
    usage: {
      prompt: usage?.promptTokenCount ?? 0,
      output: usage?.candidatesTokenCount ?? 0,
    },
    debug,
  });
}
