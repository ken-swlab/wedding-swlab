import { NextResponse } from "next/server";
import { admin } from "@/lib/firebase-admin";
import { tagDef } from "@/config/tags";
import { themeDef } from "@/config/episodes";
import { GoogleGenAI } from "@google/genai";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";
export const maxDuration = 60;

const MAX_HISTORY = 20;
const MAX_EPISODES = 24;
const MAX_BASE_PROMPT = 4000;
const MAX_MESSAGE = 1000;

type Turn = { role: "user" | "model"; text: string };
type ContextEpisode = { id: string; title: string; period: string; theme: string; content: string; isPersonal: boolean; };

function fail(message: string, status: number, extra?: Record<string, unknown>) {
  return NextResponse.json({ ok: false, message, ...extra }, { status });
}

export async function POST(req: Request) {
  try {
    return await handle(req);
  } catch (e) {
    console.error("[ai-test]", e);
    return fail(e instanceof Error ? e.message : "サーバー内部エラー", 500);
  }
}

async function handle(req: Request) {
  const { auth, db } = admin();
  const header = req.headers.get("authorization") ?? "";
  const idToken = header.startsWith("Bearer ") ? header.slice(7).trim() : "";
  if (!idToken) return fail("認証情報がありません", 401);
  try {
    const decoded = await auth.verifyIdToken(idToken, true);
    if (decoded.admin !== true) return fail("管理者権限が必要です", 403);
  } catch {
    return fail("ログインし直してください", 401);
  }

  let body: Record<string, unknown>;
  try { body = (await req.json()) as Record<string, unknown>; }
  catch { return fail("リクエストが不正です", 400); }

  const guestUid = typeof body.guestUid === "string" ? body.guestUid.trim() : "";
  if (!guestUid) return fail("ゲストを選択してください", 400);

  const preview = body.preview === true;
  const message = typeof body.message === "string" ? body.message.trim() : "";
  if (!preview && !message) return fail("メッセージを入力してください", 400);
  if (message.length > MAX_MESSAGE) return fail("メッセージが長すぎます", 400);

  const basePrompt = typeof body.basePrompt === "string" ? body.basePrompt.trim().slice(0, MAX_BASE_PROMPT) : "";

  const [guestSnap, adminSnap] = await Promise.all([
    db.collection("guests").doc(guestUid).get(),
    db.collection("guestAdmin").doc(guestUid).get(),
  ]);
  if (!guestSnap.exists) return fail("ゲストが見つかりません", 404);

  const nickname = (guestSnap.get("nickname") as string) || "";
  const realName = (guestSnap.get("realName") as string) || "";
  const displayName = (guestSnap.get("displayName") as string) || "";
  const guestTags = Array.isArray(guestSnap.get("tags")) ? (guestSnap.get("tags") as string[]) : [];
  const aiMemo = (adminSnap.get("aiMemo") as string) || "";
  const callName = nickname || displayName || realName || "ゲスト";

  let episodes: ContextEpisode[] = [];
  if (guestTags.length > 0) {
    const snap = await db
      .collection("episodes")
      .where("status", "==", "approved")
      .where("visibleToTags", "array-contains-any", guestTags.slice(0, 30))
      .orderBy("createdAt", "desc")
      .limit(100)
      .get();

    episodes = snap.docs.map((d) => {
      const v = d.data();
      const targets = Array.isArray(v.targetUids) ? (v.targetUids as string[]) : [];
      return {
        id: d.id, title: (v.title as string) || "", period: (v.period as string) || "",
        theme: (v.theme as string) || "other", content: ((v.content as string) || (v.originalText as string) || "").slice(0, 1200),
        isPersonal: targets.includes(guestUid),
      };
    }).sort((a, b) => Number(b.isPersonal) - Number(a.isPersonal)).slice(0, MAX_EPISODES);
  }

  const tagLabels = guestTags.map((t) => tagDef(t).label).join("・") || "（なし）";
  const episodeBlock = episodes.length === 0 ? "（まだエピソードがありません）" : episodes.map((e, i) => {
        const head = [`--- ${i + 1}. ${e.title || "（タイトルなし）"}`, e.period ? `（${e.period}）` : "", e.isPersonal ? ` ★${callName}さん本人についての話★` : ""].join("");
        return `${head}\n［お題: ${themeDef(e.theme).label}］\n${e.content}`;
      }).join("\n\n");

  const systemInstruction = `${basePrompt || "あなたは新郎です。明るくフランクに話します。"}

━━━━━━━━━━━━━━━━━━━━
【いま話している相手】
・呼び名: ${callName}
${realName ? `・本名: ${realName}\n` : ""}・グループ: ${tagLabels}
${aiMemo ? `・新郎新婦のメモ: ${aiMemo}` : "・新郎新婦のメモ: （なし）"}

━━━━━━━━━━━━━━━━━━━━
【あなたが知っているエピソード】
※ここに書かれていることだけが、あなたの知識です。

${episodeBlock}

━━━━━━━━━━━━━━━━━━━━
【必ず守ること】
1. 上のエピソードに書かれていないことは、絶対に作り話をしない。
2. 知らないことを聞かれたら、正直に知らないと認めて
   「あっちにいる本人に聞いてよ！」と返す。ごまかさない。
3. ★上に載っていないゲストの話・個人情報には一切触れない。★
   名前を出してよいのは、上のエピソードに登場する人物だけ。
4. 返事は2〜3文、長くても120文字程度。披露宴の立ち話のテンポで。
5. 相手のことは「${callName}」と呼ぶ。
6. 新郎新婦のメモは、あなたの心構えとして使う。
   メモの内容そのものを相手に読み上げない。`;

  const project = process.env.GCP_PROJECT_ID || process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID || "";
  const location = process.env.GCP_LOCATION || "asia-northeast1";
  const model = process.env.VERTEX_MODEL || "gemini-2.0-flash";

  const debug = {
    callName, tagLabels, aiMemo,
    episodes: episodes.map((e) => ({ id: e.id, title: e.title, period: e.period, theme: e.theme, isPersonal: e.isPersonal, content: e.content })),
    systemInstruction, model
  };

  if (preview) return NextResponse.json({ ok: true, preview: true, debug });

  const rawHistory = Array.isArray(body.history) ? (body.history as unknown[]) : [];
  const history: Turn[] = rawHistory
    .filter((t): t is Turn => typeof t === "object" && t !== null && ((t as Turn).role === "user" || (t as Turn).role === "model") && typeof (t as Turn).text === "string")
    .slice(-MAX_HISTORY);

  const contents = [
    ...history.map((t) => ({ role: t.role, parts: [{ text: t.text }] })),
    { role: "user", parts: [{ text: message }] },
  ];

  if (!project) return fail("GCP_PROJECT_ID が未設定です", 500, { debug });

  try {
    const ai = new GoogleGenAI({ vertexai: { project, location } });
    const response = await ai.models.generateContent({
      model,
      contents,
      config: {
        systemInstruction,
        temperature: 0.9,
        topP: 0.95,
        maxOutputTokens: 400,
        safetySettings: [
          { category: "HARM_CATEGORY_HATE_SPEECH", threshold: "BLOCK_ONLY_HIGH" },
          { category: "HARM_CATEGORY_DANGEROUS_CONTENT", threshold: "BLOCK_ONLY_HIGH" },
          { category: "HARM_CATEGORY_HARASSMENT", threshold: "BLOCK_ONLY_HIGH" },
          { category: "HARM_CATEGORY_SEXUALLY_EXPLICIT", threshold: "BLOCK_ONLY_HIGH" },
        ]
      }
    });

    const text = response.text;
    if (!text) return fail("AI が応答を返しませんでした", 502, { debug });

    return NextResponse.json({
      ok: true, text,
      usage: { prompt: response.usageMetadata?.promptTokenCount ?? 0, output: response.usageMetadata?.candidatesTokenCount ?? 0 },
      debug,
    });
  } catch (e) {
    console.error("[ai-test] GenAI Error:", e);
    return fail(`Vertex AI の呼び出しに失敗しました: ${e instanceof Error ? e.message : String(e)}`, 502, { debug });
  }
}
