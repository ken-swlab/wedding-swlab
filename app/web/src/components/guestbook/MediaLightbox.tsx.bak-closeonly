"use client";

import Image from "next/image";
import { useCallback, useEffect, useRef } from "react";
import type { MediaItem } from "@/types";

/** 手動アップロード方式になったので「送信中」ではなく状態をそのまま伝える */
const ORIGINAL_NOTE: Partial<Record<NonNullable<MediaItem["originalStatus"]>, string>> = {
  pending: "高画質版はまだ送信されていません",
  failed: "高画質版の送信に失敗しています",
  unavailable: "高画質版は取得できませんでした",
};

/**
 * 拡大表示。originalUrl があればそちらを出す。
 * 二段階アップロードの「原本」が意味を持つのがここ。
 *
 * ★重なり順に注意★
 *   写真コンテナは position 指定があるため、z-index を明示しないと
 *   DOM 順で後ろにある要素が前に出る。閉じるボタンを先に書くと
 *   写真に覆われてタップが一切届かなくなる（実際にそうなっていた）。
 *   写真は z-0、操作系は z-20 以上、と明示的に分ける。
 */
export function MediaLightbox({
  media,
  index,
  onClose,
  onMove,
}: {
  media: MediaItem[];
  index: number;
  onClose: () => void;
  onMove: (next: number) => void;
}) {
  const item = media[index];

  // click と touchend の両方を受けるため、1回だけ閉じるようガードする
  const closedRef = useRef(false);
  const close = useCallback(() => {
    if (closedRef.current) return;
    closedRef.current = true;
    onClose();
  }, [onClose]);

  const handleKey = useCallback(
    (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
      if (e.key === "ArrowRight") onMove((index + 1) % media.length);
      if (e.key === "ArrowLeft") onMove((index - 1 + media.length) % media.length);
    },
    [index, media.length, close, onMove],
  );

  useEffect(() => {
    window.addEventListener("keydown", handleKey);
    const prev = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => {
      window.removeEventListener("keydown", handleKey);
      document.body.style.overflow = prev;
    };
  }, [handleKey]);

  if (!item) return null;
  const src = item.originalUrl ?? item.url;
  const note = item.originalStatus ? ORIGINAL_NOTE[item.originalStatus] : undefined;

  // ★閉じる操作は×ボタンだけに一本化する★
  //   披露宴では片手・ほろ酔いでの操作になる。背景や写真のタップで閉じると、
  //   拡大してじっくり見ようとしただけで消え、端末を握る指がフチに触れただけでも
  //   消える。誤タップの余地を残さないよう、背景にも写真にもハンドラを置かない。
  return (
    <div
      role="dialog"
      aria-modal="true"
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4"
    >
      {/* --- 写真・動画（最背面。タップしても閉じない） --- */}
      <div className="relative z-0 h-full w-full">
        {item.type === "video" ? (
          <video src={src} controls autoPlay playsInline className="h-full w-full object-contain" />
        ) : (
          <Image
            src={src}
            alt={item.alt ?? ""}
            fill
            sizes="100vw"
            className="object-contain"
            priority
          />
        )}
      </div>

      {/* --- 前後の移動 --- */}
      {media.length > 1 && (
        <>
          <button
            type="button"
            aria-label="前へ"
            onClick={() => onMove((index - 1 + media.length) % media.length)}
            className="absolute left-3 z-20 flex h-12 w-12 touch-manipulation items-center justify-center rounded-full bg-white/15 text-2xl leading-none text-white transition active:bg-white/35"
          >
            ‹
          </button>
          <button
            type="button"
            aria-label="次へ"
            onClick={() => onMove((index + 1) % media.length)}
            className="absolute right-3 z-20 flex h-12 w-12 touch-manipulation items-center justify-center rounded-full bg-white/15 text-2xl leading-none text-white transition active:bg-white/35"
          >
            ›
          </button>
          <p className="absolute bottom-5 z-20 text-xs tabular-nums text-white/60">
            {index + 1} / {media.length}
          </p>
        </>
      )}

      {note && (
        <p className="absolute bottom-12 z-20 rounded-full bg-white/10 px-3 py-1 text-[11px] text-white/70">
          {note}
        </p>
      )}

      {/* --- 閉じる（唯一の出口。最前面かつ DOM の最後に置く） --- */}
      <button
        type="button"
        onClick={close}
        onTouchEnd={(e) => {
          // ×の上で指を離したときだけ閉じる。
          // 押したまま外へずらして離した場合は、誤爆とみなして無視する。
          const t = e.changedTouches[0];
          if (!t) return;
          const r = e.currentTarget.getBoundingClientRect();
          const inside =
            t.clientX >= r.left &&
            t.clientX <= r.right &&
            t.clientY >= r.top &&
            t.clientY <= r.bottom;
          if (!inside) return;
          e.preventDefault();
          close();
        }}
        aria-label="閉じる"
        style={{ top: "max(0.75rem, env(safe-area-inset-top))" }}
        className="absolute right-3 z-30 flex h-12 w-12 touch-manipulation items-center justify-center rounded-full bg-black/55 text-2xl leading-none text-white ring-1 ring-white/45 backdrop-blur transition active:bg-black/80"
      >
        ×
      </button>
    </div>
  );
}
