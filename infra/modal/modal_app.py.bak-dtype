"""
Style-Bert-VITS2 を Modal のサーバーレス GPU で動かす TTS API。

--- 開発中（ログが手元のターミナルに流れる） -------------------------------
  pip install -U modal
  modal serve infra/modal/modal_app.py
    → 一時 URL が表示される。末尾に /tts を付けて .env.local の
      MODAL_TTS_URL に入れる。保存すると自動でリロードされる。

--- API を介さない単体テスト（一番デバッグしやすい） -----------------------
  modal run infra/modal/modal_app.py --text "今日は来てくれてありがとう"
    → sbv2_test.wav がカレントに出る。例外はそのまま手元に表示される。

--- 本番デプロイ -----------------------------------------------------------
  modal volume create sbv2-models
  modal volume put sbv2-models ./model_assets/<モデル名> /<モデル名>
  modal secret create sbv2-auth SBV2_TTS_TOKEN=<十分に長いランダム文字列>
  modal deploy infra/modal/modal_app.py
  modal app logs sbv2-tts        # デプロイ済みアプリのログを追う

--- Modal のバージョン差異 -------------------------------------------------
  modal.App        ← 旧 modal.Stub
  scaledown_window ← 旧 container_idle_timeout
  min_containers   ← 旧 keep_warm
  まず `pip install -U modal` で最新にするのが確実。
"""

import io
import os
import pathlib
import traceback
import wave

import modal

APP_NAME = "sbv2-tts"
BERT_MODEL = "ku-nlp/deberta-v2-large-japanese-char-wwm"
MODEL_DIR = "/models"
MAX_TEXT = 400

volume = modal.Volume.from_name("sbv2-models", create_if_missing=True)


def _bake_assets() -> None:
    """イメージビルド時に依存と辞書を焼き込み、環境を記録する。

    ★ここで try/except を使わない★
      握りつぶすと「ビルドは成功、実行時に毎回失敗」という最悪の形になる。
      壊れているならビルドを失敗させて、その場で気づけるようにする。
    """
    import subprocess
    import sys

    print(f"[build] python = {sys.version}")

    # pkg_resources は setuptools の一部。pyopenjtalk が辞書パスの解決に使う。
    # ★setuptools は新しいほど良いわけではない★
    #   最近の版では pkg_resources が同梱されなくなったため、
    #   上限なしの指定（>=68 など）は「使えない版」を確実に引く。
    import pkg_resources

    ver = pkg_resources.get_distribution("setuptools").version
    print(f"[build] setuptools = {ver}")

    from huggingface_hub import snapshot_download

    snapshot_download(BERT_MODEL)
    print("[build] BERT のダウンロード完了")

    import pyopenjtalk

    print("[build] pyopenjtalk g2p =", pyopenjtalk.g2p("テスト"))

    # 将来ズレたときに突き合わせられるよう、全依存をビルドログに残す
    print("[build] --- pip freeze ---")
    print(
        subprocess.run(
            [sys.executable, "-m", "pip", "freeze"], capture_output=True, text=True
        ).stdout
    )
    print("[build] すべて OK")


# 検証済みの環境を再現するためのロックファイル。
# 存在すればこちらが優先される（作り方は下の local_entrypoint を参照）。
LOCK_FILE = pathlib.Path(__file__).parent / "requirements.lock.txt"


def _build_image() -> modal.Image:
    base = modal.Image.debian_slim(python_version="3.10").apt_install(
        "git", "curl", "build-essential", "cmake", "pkg-config"
    )

    try:
        locked = LOCK_FILE.exists()
    except Exception:  # noqa: BLE001
        locked = False

    if locked:
        # ★本番はこちら★ テストした環境をそのまま再現する
        base = base.pip_install_from_requirements(str(LOCK_FILE))
    else:
        base = (
            base.pip_install("numpy<2")
            .pip_install("torch")
            .pip_install("style-bert-vits2", "huggingface_hub", "fastapi[standard]")
        )

    # ★setuptools は必ず最後★
    #   レイヤーが後続から見えないのではない。逆で、後続の pip_install が
    #   依存解決の過程で setuptools を最新版に巻き戻してしまう。
    #   pkg_resources を残すには、誰にも上書きされない位置に置くしかない。
    return base.pip_install("setuptools==69.5.1", "wheel").run_function(_bake_assets)


image = _build_image()

app = modal.App(APP_NAME)


def _find_model(root: pathlib.Path):
    """Volume 内から SBV2 のモデル3点セットを探す。
    ファイル名は学習時の epoch/step で変わるので決め打ちしない。"""
    override = os.environ.get("SBV2_MODEL_NAME")
    dirs = [root / override] if override else sorted(p for p in root.iterdir() if p.is_dir())

    for d in dirs:
        if not d.is_dir():
            continue
        safetensors = sorted(d.glob("*.safetensors"))
        config = d / "config.json"
        style = d / "style_vectors.npy"
        if safetensors and config.exists() and style.exists():
            return safetensors[-1], config, style

    listing = [p.name for p in root.iterdir()] if root.exists() else []
    raise RuntimeError(
        f"{root} に SBV2 モデルが見つかりません（中身: {listing}）。"
        " <名前>/*.safetensors, <名前>/config.json, <名前>/style_vectors.npy の3点が必要です。"
    )


def _f(v, default: float, lo: float, hi: float) -> float:
    try:
        n = float(v)
    except (TypeError, ValueError):
        return default
    if n != n:  # NaN
        return default
    return max(lo, min(hi, n))


def _to_wav(sample_rate: int, audio) -> bytes:
    """numpy 配列を 16bit モノラル WAV にする。soundfile に依存しない。"""
    import numpy as np

    arr = np.asarray(audio)
    if arr.ndim > 1:
        arr = arr.reshape(-1)
    if arr.dtype != np.int16:
        arr = np.clip(arr.astype("float32"), -1.0, 1.0)
        arr = (arr * 32767.0).astype(np.int16)

    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(sample_rate))
        w.writeframes(arr.tobytes())
    return buf.getvalue()


@app.cls(
    image=image,
    gpu="T4",
    volumes={MODEL_DIR: volume},
    secrets=[modal.Secret.from_name("sbv2-auth")],
    scaledown_window=300,
    # ★披露宴当日はこのコメントを外してコンテナを常駐させる★
    # min_containers=1,
    timeout=120,
)
class SBV2:
    @modal.enter()
    def load(self):
        """コンテナ起動時に1回だけ走る。ここでモデルを載せ切る。"""
        import sys

        print(f"[sbv2] python = {sys.version.split()[0]}")
        try:
            import pkg_resources

            print(f"[sbv2] setuptools = {pkg_resources.get_distribution('setuptools').version}")
        except Exception as e:  # noqa: BLE001
            print(f"[sbv2] ❌ pkg_resources が使えません: {e}")

        import torch
        from style_bert_vits2.constants import Languages
        from style_bert_vits2.nlp import bert_models
        from style_bert_vits2.tts_model import TTSModel

        print(f"[sbv2] torch = {torch.__version__} / cuda = {torch.cuda.is_available()}")

        try:
            volume.reload()  # デプロイ後にアップロードしたモデルも拾う
        except Exception as e:  # noqa: BLE001
            print(f"[sbv2] volume.reload をスキップ: {e}")

        bert_models.load_model(Languages.JP, BERT_MODEL)
        bert_models.load_tokenizer(Languages.JP, BERT_MODEL)

        model_path, config_path, style_path = _find_model(pathlib.Path(MODEL_DIR))
        self.device = "cuda" if torch.cuda.is_available() else "cpu"
        print(f"[sbv2] device={self.device} model={model_path.name}")

        self.model = TTSModel(
            model_path=str(model_path),
            config_path=str(config_path),
            style_vec_path=str(style_path),
            device=self.device,
        )

        # ★握りつぶさない★ 失敗したらスタックトレースを必ず出す
        try:
            self.model.infer(text="テスト")
            print("[sbv2] ウォームアップ完了")
        except Exception:  # noqa: BLE001
            print("[sbv2] ❌ ウォームアップ失敗:")
            traceback.print_exc()

    def _styles(self) -> list:
        """モデルが持つスタイル名。属性名は版によって違うので保険を重ねる"""
        v = getattr(self.model, "style2id", None)
        if isinstance(v, dict) and v:
            return list(v.keys())
        hps = getattr(self.model, "hyper_parameters", None) or getattr(self.model, "hps", None)
        data = getattr(hps, "data", None) if hps else None
        v = getattr(data, "style2id", None)
        if isinstance(v, dict) and v:
            return list(v.keys())
        return ["Neutral"]

    def _synth(self, text: str, p: dict) -> bytes:
        """合成の実体。Web からも modal run からも、ここを呼ぶ。"""
        sr, audio = self.model.infer(
            text=text,
            sdp_ratio=_f(p.get("sdp_ratio"), 0.2, 0.0, 1.0),
            noise=_f(p.get("noise"), 0.6, 0.0, 2.0),
            noise_w=_f(p.get("noise_w"), 0.8, 0.0, 2.0),
            length=_f(p.get("length"), 1.0, 0.5, 2.0),
            style=p.get("style_name") or "Neutral",
            style_weight=_f(p.get("style_weight"), 1.0, 0.0, 10.0),
        )
        return _to_wav(sr, audio)

    @modal.method()
    def synth(self, text: str, params: dict | None = None) -> bytes:
        """modal run から呼ぶための入口。例外は手元のターミナルに出る。"""
        return self._synth(text, params or {})

    @modal.asgi_app()
    def web(self):
        from fastapi import FastAPI, HTTPException, Request, Response

        api = FastAPI(title="SBV2 TTS")
        expected = os.environ.get("SBV2_TTS_TOKEN", "")

        def check(request: Request):
            # 公開 URL なので共有シークレットで守る。
            # 無防備な GPU エンドポイントは、そのまま課金の穴になる。
            if expected and request.headers.get("x-tts-token", "") != expected:
                raise HTTPException(status_code=401, detail="invalid token")

        @api.get("/health")
        def health(request: Request):
            check(request)
            # 式の直前にこれを叩いてコンテナを温める
            return {"ok": True, "device": self.device, "styles": self._styles()}

        @api.get("/styles")
        def styles(request: Request):
            check(request)
            return {"styles": self._styles()}

        @api.post("/tts")
        async def tts(request: Request):
            check(request)
            try:
                payload = await request.json()
            except Exception as e:  # noqa: BLE001
                raise HTTPException(status_code=400, detail="invalid json") from e

            text = str(payload.get("text") or "").strip()
            if not text:
                raise HTTPException(status_code=400, detail="text is empty")
            if len(text) > MAX_TEXT:
                raise HTTPException(status_code=400, detail="text too long")

            try:
                wav = self._synth(text, payload)
            except Exception as e:  # noqa: BLE001
                # ★スタックトレースを必ずログに出す★
                #   「合成に失敗しました」だけでは Modal のダッシュボードを見ても
                #   原因が分からず、前回はここで詰まった。
                print(f"[sbv2] ❌ 合成に失敗: {type(e).__name__}: {e}")
                traceback.print_exc()
                raise HTTPException(
                    status_code=500, detail=f"{type(e).__name__}: {e}"
                ) from e

            return Response(content=wav, media_type="audio/wav")

        return api


@app.function(image=image)
def freeze_env() -> str:
    """コンテナ内の pip freeze をそのまま返す"""
    import subprocess
    import sys

    return subprocess.run(
        [sys.executable, "-m", "pip", "freeze"], capture_output=True, text=True
    ).stdout


@app.local_entrypoint()
def main(text: str = "今日は来てくれて、本当にありがとう！", lock: bool = False):
    """API を介さず合成だけ試す。ログと例外が手元のターミナルに出る。

    --lock を付けると、いま動いている環境を requirements.lock.txt に固定する。
    """
    if lock:
        body = freeze_env.remote()
        LOCK_FILE.write_text(body, encoding="utf-8")
        print(f"✅ {LOCK_FILE} に固定しました（{len(body.splitlines())} 行）")
        print("   次回以降のビルドはこのファイルから再現されます。")
        print("   もし固定版でビルドが通らなくなったら、このファイルを消せば元に戻ります。")
        return

    wav = SBV2().synth.remote(text, {})
    out = pathlib.Path("sbv2_test.wav")
    out.write_bytes(wav)
    print(f"✅ {out} に書き出しました（{len(wav)} bytes）")
