rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myUid()    { return request.auth.uid; }
    function myTags() { return signedIn() && 'tags' in request.auth.token ? request.auth.token.tags : []; }
    function isAdmin() { return signedIn() && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function canSee(data) { return isAdmin() || data.visibleToTags.hasAny(myTags()); }
    function tagsInMyScope(data) {
      return isAdmin() || (
        data.visibleToTags is list && data.visibleToTags.size() >= 1 && data.visibleToTags.size() <= 20 && data.visibleToTags.hasOnly(myTags())
      );
    }

    // =====================================================
    // /guests/{uid} : 他のゲストにも見せてよい公開プロフィール
    //
    //   ★氏名系のフィールドはここに存在しない★
    //     displayName / realName / kana / lineDisplayName は
    //     guestPrivate へ移設済み。ここに残っているのは
    //     nickname / photoURL / tags / 各種フラグだけ。
    //
    //   ★承認前のユーザーには名簿を見せない★
    //     LINE ログインを通しただけ（tags が空）の相手に
    //     ゲスト一覧を list させない。@メンションの候補は
    //     承認済みゲストだけが必要とする機能なので、
    //     tags を1つ以上持っていることを条件にする。
    //     自分自身のドキュメントだけは常に読める
    //     （オンボーディングの分岐判定に必要）。
    // =====================================================
    match /guests/{uid} {
      allow get:  if signedIn() && (uid == myUid() || isAdmin() || myTags().size() > 0);
      allow list: if (isAdmin() && request.query.limit <= 500)
        || (signedIn() && myTags().size() > 0 && request.query.limit <= 200);

      // ★作成はサーバー専用★
      //   以前はクライアントの ensureGuestDoc() 用に開けていたが、
      //   その関数は呼び出し元が無く削除した。現在ドキュメントを
      //   作るのは /api/auth/line（Admin SDK）だけで、Admin SDK は
      //   Rules を経由しない。開けておく理由が無いので閉じる。
      allow create: if false;

      // ★本人も直接は書けない★
      //   以前は本人に photoURL / bio の更新を許していたが、長さやアイコンの URL の
      //   検証を迂回できた。プロフィールの変更は /api/guest/profile（Admin SDK）が
      //   検証してから書く。LINE のアイコンの追従は /api/auth/line が行う。
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 投稿者の表示名・アイコンの形（中身の正しさは表示側が guests の最新値で補う。profiles-client の★参照）
    function validAuthor(d) {
      return d.authorName is string && d.authorName.size() >= 1 && d.authorName.size() <= 40
        && (!('authorPhotoURL' in d) || (d.authorPhotoURL is string && d.authorPhotoURL.size() <= 1024));
    }
    function validPost(d) {
      return validAuthor(d) && d.keys().hasAll(['authorUid','authorName','text','media','visibleToTags','hashtags','mentions','status','reactionCount','commentCount','createdAt']) && d.keys().hasOnly(['authorUid','authorName','authorPhotoURL','text','media','visibleToTags','hashtags','mentions','status','reactionCount','commentCount','createdAt','updatedAt']) && d.text is string && d.text.size() <= 4000 && d.media is list && d.media.size() <= 4 && d.hashtags is list && d.hashtags.size() <= 10 && d.mentions is list && d.mentions.size() <= 10 && d.status == 'visible' && d.reactionCount == 0 && d.commentCount == 0 && d.createdAt == request.time;
    }
    // updatedAt を変えるならサーバー時刻（serverTimestamp()）だけ。変えない更新はそのまま通す
    function updatedAtIsNow() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
        || request.resource.data.updatedAt == request.time;
    }
    // ★カウンタは ±1 だけ、0 未満にしない、updatedAt はサーバー時刻だけ★
    function counterStep(field, delta) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field, 'updatedAt'])
        && request.resource.data[field] == resource.data[field] + delta
        && request.resource.data[field] >= 0
        && updatedAtIsNow();
    }
    // ★いいねの数は、自分のリアクションの作成・削除と同じトランザクションでだけ動かせる★
    //   以前は見える投稿なら誰でも何度でも ±1 でき、いいね数を水増しできた（lib/posts.ts の toggleReaction）。
    function myReaction(postId) {
      return /databases/$(database)/documents/posts/$(postId)/reactions/$(myUid());
    }
    function reactionAdded(postId)   { return !exists(myReaction(postId)) && existsAfter(myReaction(postId)); }
    function reactionRemoved(postId) { return exists(myReaction(postId)) && !existsAfter(myReaction(postId)); }
    // ★非表示（status != 'visible'）の投稿はゲストに見せない★ 管理者と投稿者本人は読める
    //   （本人は高画質版の状態を更新するトランザクションで自分の投稿を読む。lib/media.ts）。
    function canRead(data) {
      return isAdmin() || data.authorUid == myUid() || (data.status == 'visible' && canSee(data));
    }

    match /posts/{postId} {
      allow get:  if signedIn() && resource != null && canRead(resource.data);
      allow list: if signedIn() && request.query.limit <= 50 && canRead(resource.data);
      allow create: if signedIn() && request.resource.data.authorUid == myUid() && validPost(request.resource.data) && tagsInMyScope(request.resource.data);
      // ★投稿者本人が変えられるのは media（高画質版の状態）と updatedAt だけ★
      //   本文・公開範囲（visibleToTags）を後から変える画面は無い。特に公開範囲を狭められると、
      //   投稿時の範囲を写したコメントの visibleToTags が広いまま残り、collectionGroup の購読から漏れる。
      //   編集機能を足すときは、コメントの範囲との整合を決めてからここを開ける。
      allow update: if isAdmin()
        || (signedIn() && resource.data.authorUid == myUid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['media','updatedAt'])
            && request.resource.data.media is list && request.resource.data.media.size() <= 4
            && updatedAtIsNow())
        || (signedIn() && canRead(resource.data) && counterStep('reactionCount', 1) && reactionAdded(postId))
        || (signedIn() && canRead(resource.data) && counterStep('reactionCount', -1) && reactionRemoved(postId))
        || (signedIn() && canRead(resource.data) && counterStep('commentCount', 1))
        || (signedIn() && canRead(resource.data) && counterStep('commentCount', -1));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == myUid());

      match /comments/{commentId} {
        function parentPost() { return get(/databases/$(database)/documents/posts/$(postId)).data; }
        function validComment(d, parent) { return validAuthor(d) && d.keys().hasAll(['authorUid','authorName','text','hashtags','mentions','visibleToTags','createdAt']) && d.keys().hasOnly(['authorUid','authorName','authorPhotoURL','text','hashtags','mentions','visibleToTags','createdAt']) && d.text is string && d.text.size() > 0 && d.text.size() <= 600 && d.hashtags is list && d.hashtags.size() <= 10 && d.mentions is list && d.mentions.size() <= 10 && d.visibleToTags == parent.visibleToTags && d.createdAt == request.time; }
        // ★非表示にした投稿のコメントは visibleToTags が空になる（/api/admin/posts/visibility の★）★
        //   canSee() では誰にも見えなくなるので、書いた本人だけは読めるようにする（「非表示になりました」を出すため）。
        allow get:  if signedIn() && resource != null && (canSee(resource.data) || resource.data.authorUid == myUid());
        allow list: if signedIn() && request.query.limit <= 100 && canRead(parentPost());
        // 非表示の投稿にはコメントできない（隠したあとに付いたコメントが、投稿の範囲を写して見えてしまうため）
        allow create: if signedIn() && request.resource.data.authorUid == myUid()
          && parentPost().status == 'visible' && canSee(parentPost())
          && validComment(request.resource.data, parentPost());
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == myUid());
      }
      // ★リアクションは本人の1件だけを読み書きする★
      //   以前は読み取りをサインイン済みの全員に開けていた（承認前の人や、投稿が見えない人でも、
      //   誰がどの投稿にいいねしたかを読めた）。クライアントが読むのは自分の1件だけ（useMyReaction）。
      //   作成も、その投稿が見える人に限る。
      match /reactions/{uid} {
        allow get: if isAdmin() || (signedIn() && uid == myUid());
        allow list: if isAdmin() && request.query.limit <= 500;
        allow create, update: if signedIn() && uid == myUid()
          && canRead(get(/databases/$(database)/documents/posts/$(postId)).data)
          && request.resource.data.keys().hasOnly(['emoji','uid','createdAt'])
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
          && (!('uid' in request.resource.data) || request.resource.data.uid == myUid())
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
        allow delete: if signedIn() && uid == myUid();
      }
    }
    match /challenges/{challengeId} { allow get:  if signedIn() && resource != null && canSee(resource.data); allow list: if signedIn() && request.query.limit <= 100 && canSee(resource.data); allow write: if false; }
    match /solves/{solveId} { allow get, list: if signedIn() && (isAdmin() || resource.data.uid == myUid()); allow write: if false; }
    
    // ★追加箇所: 管理者専用の裏データアクセス許可
    // =====================================================
    // /guestPrivate/{uid} : 本人と管理者だけが読める領域
    //   氏名（displayName / realName / kana / lineDisplayName）・
    //   出欠・アレルギー（健康情報）・送金ステータスを置く。
    //   運営メモ (aiMemo) とは別の場所にすることで、
    //   本人が自分の回答だけを読み返せるようにしている。
    //   書き込みは Route Handler (Admin SDK) 経由のみ。
    // =====================================================
    match /guestPrivate/{uid} {
      allow get:   if isAdmin() || (signedIn() && uid == myUid());
      allow list:  if isAdmin() && request.query.limit <= 500;
      allow write: if false;
    }

    match /guestAdmin/{uid} {
      allow get:   if isAdmin();
      allow list:  if isAdmin() && request.query.limit <= 500;
      allow write: if false;
    }
    // =====================================================
    // /faces/{faceId} : Rekognition が検出した顔の座標
    // =====================================================
    match /faces/{faceId} {
      allow get:   if isAdmin();
      allow list:  if isAdmin() && request.query.limit <= 300;
      allow write: if false;
    }


    // =====================================================
    // /episodes/{episodeId} : ゲストから集めた思い出エピソード
    //   ミニAI の文脈と、オープニングムービーの素材になる。
    //
    //   ★visibleToTags で ABAC をかける★
    //     targetTags（誰についての話か）とは別のフィールド。
    //     兼務させると、限定公開のエピソードが
    //     他のゲストへの AI 回答に混ざる。
    //   書き込みは Route Handler (Admin SDK) 経由のみ。
    // =====================================================
    match /episodes/{episodeId} {
      allow get: if isAdmin()
        || (signedIn()
            && resource != null
            && resource.data.status == 'approved'
            && canSee(resource.data));

      allow list: if (isAdmin() && request.query.limit <= 500)
        || (signedIn()
            && request.query.limit <= 50
            && resource.data.status == 'approved'
            && canSee(resource.data));

      allow write: if false;
    }

    // =====================================================
    // /tags/{tagId} : 管理者が作ったカスタムタグの辞書
    //   ★ここにあるのは表示用の語彙（ラベルと色）だけ★
    //     権限そのものは Custom Claims の tags が持っているので、
    //     このコレクションが空でも組み込みタグは通常どおり動く。
    //   書き込みは Route Handler (Admin SDK) 経由のみ。
    // =====================================================
    match /tags/{tagId} {
      allow get:   if signedIn();
      allow list:  if signedIn() && request.query.limit <= 200;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
    // =====================================================
    // collectionGroup("comments") 用のルール
    //   ★上の match /posts/{postId}/comments/{id} は
    //     コレクショングループクエリには適用されない★
    //     /screen が全投稿横断でコメントを購読するために必要。
    //   ABAC は resource.data.visibleToTags で1件ずつ評価される。
    // =====================================================
    //   ★書いた本人は、非表示になった自分のコメントも一覧できる★（マイページの「非表示になったコメント」。
    //     クエリは where("authorUid", "==", 自分) を付ける。非表示のコメントは visibleToTags が空なので canSee では外れる）
    match /{path=**}/comments/{commentId} {
      allow list: if signedIn()
        && request.query.limit <= 100
        && (isAdmin() || canSee(resource.data) || resource.data.authorUid == myUid());
    }

  }
}
