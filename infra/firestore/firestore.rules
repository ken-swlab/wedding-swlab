rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myUid()    { return request.auth.uid; }
    function myTags() { return signedIn() && 'tags' in request.auth.token ? request.auth.token.tags : []; }
    function isAdmin() { return signedIn() && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function canSee(data) { return isAdmin() || data.visibleToTags.hasAny(myTags()); }
    function tagsInMyScope(data) {
      return isAdmin() || (
        data.visibleToTags is list && data.visibleToTags.size() >= 1 && data.visibleToTags.size() <= 20 && data.visibleToTags.hasOnly(myTags())
      );
    }

    // =====================================================
    // /guests/{uid} : 他のゲストにも見せてよい公開プロフィール
    //
    //   ★氏名系のフィールドはここに存在しない★
    //     displayName / realName / kana / lineDisplayName は
    //     guestPrivate へ移設済み。ここに残っているのは
    //     nickname / photoURL / tags / 各種フラグだけ。
    //
    //   ★承認前のユーザーには名簿を見せない★
    //     LINE ログインを通しただけ（tags が空）の相手に
    //     ゲスト一覧を list させない。@メンションの候補は
    //     承認済みゲストだけが必要とする機能なので、
    //     tags を1つ以上持っていることを条件にする。
    //     自分自身のドキュメントだけは常に読める
    //     （オンボーディングの分岐判定に必要）。
    // =====================================================
    match /guests/{uid} {
      allow get:  if signedIn() && (uid == myUid() || isAdmin() || myTags().size() > 0);
      allow list: if (isAdmin() && request.query.limit <= 500)
        || (signedIn() && myTags().size() > 0 && request.query.limit <= 200);

      // ★作成はサーバー専用★
      //   以前はクライアントの ensureGuestDoc() 用に開けていたが、
      //   その関数は呼び出し元が無く削除した。現在ドキュメントを
      //   作るのは /api/auth/line（Admin SDK）だけで、Admin SDK は
      //   Rules を経由しない。開けておく理由が無いので閉じる。
      allow create: if false;

      // 本人が変えてよいのはアイコンと自己紹介だけ。
      // 表示名は guestPrivate に移したのでここからは外す。
      allow update: if isAdmin()
        || (signedIn() && uid == myUid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL','bio','updatedAt']));
      allow delete: if isAdmin();
    }

    function validPost(d) {
      return d.keys().hasAll(['authorUid','authorName','text','media','visibleToTags','hashtags','mentions','status','reactionCount','commentCount','createdAt']) && d.keys().hasOnly(['authorUid','authorName','authorPhotoURL','text','media','visibleToTags','hashtags','mentions','status','reactionCount','commentCount','createdAt','updatedAt']) && d.text is string && d.text.size() <= 4000 && d.media is list && d.media.size() <= 4 && d.hashtags is list && d.hashtags.size() <= 10 && d.mentions is list && d.mentions.size() <= 10 && d.status == 'visible' && d.reactionCount == 0 && d.commentCount == 0 && d.createdAt == request.time;
    }
    function counterStep(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field, 'updatedAt']) && (request.resource.data[field] == resource.data[field] + 1 || request.resource.data[field] == resource.data[field] - 1);
    }

    match /posts/{postId} {
      allow get:  if signedIn() && resource != null && canSee(resource.data);
      allow list: if signedIn() && request.query.limit <= 50 && canSee(resource.data);
      allow create: if signedIn() && request.resource.data.authorUid == myUid() && validPost(request.resource.data) && tagsInMyScope(request.resource.data);
      allow update: if isAdmin() || (signedIn() && resource.data.authorUid == myUid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','media','visibleToTags','hashtags','mentions','updatedAt']) && tagsInMyScope(request.resource.data)) || (signedIn() && canSee(resource.data) && counterStep('reactionCount')) || (signedIn() && canSee(resource.data) && counterStep('commentCount'));
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == myUid());

      match /comments/{commentId} {
        function parentPost() { return get(/databases/$(database)/documents/posts/$(postId)).data; }
        function validComment(d, parent) { return d.keys().hasAll(['authorUid','authorName','text','hashtags','mentions','visibleToTags','createdAt']) && d.keys().hasOnly(['authorUid','authorName','authorPhotoURL','text','hashtags','mentions','visibleToTags','createdAt']) && d.text is string && d.text.size() > 0 && d.text.size() <= 600 && d.hashtags is list && d.hashtags.size() <= 10 && d.mentions is list && d.mentions.size() <= 10 && d.visibleToTags == parent.visibleToTags && d.createdAt == request.time; }
        allow get:  if signedIn() && resource != null && canSee(resource.data);
        allow list: if signedIn() && request.query.limit <= 100 && canSee(parentPost());
        allow create: if signedIn() && request.resource.data.authorUid == myUid() && canSee(parentPost()) && validComment(request.resource.data, parentPost());
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == myUid());
      }
      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == myUid() && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8;
        allow delete: if signedIn() && uid == myUid();
      }
    }
    match /challenges/{challengeId} { allow get:  if signedIn() && resource != null && canSee(resource.data); allow list: if signedIn() && request.query.limit <= 100 && canSee(resource.data); allow write: if false; }
    match /solves/{solveId} { allow get, list: if signedIn() && (isAdmin() || resource.data.uid == myUid()); allow write: if false; }
    
    // ★追加箇所: 管理者専用の裏データアクセス許可
    // =====================================================
    // /guestPrivate/{uid} : 本人と管理者だけが読める領域
    //   氏名（displayName / realName / kana / lineDisplayName）・
    //   出欠・アレルギー（健康情報）・送金ステータスを置く。
    //   運営メモ (aiMemo) とは別の場所にすることで、
    //   本人が自分の回答だけを読み返せるようにしている。
    //   書き込みは Route Handler (Admin SDK) 経由のみ。
    // =====================================================
    match /guestPrivate/{uid} {
      allow get:   if isAdmin() || (signedIn() && uid == myUid());
      allow list:  if isAdmin() && request.query.limit <= 500;
      allow write: if false;
    }

    match /guestAdmin/{uid} {
      allow get:   if isAdmin();
      allow list:  if isAdmin() && request.query.limit <= 500;
      allow write: if false;
    }
    // =====================================================
    // /faces/{faceId} : Rekognition が検出した顔の座標
    // =====================================================
    match /faces/{faceId} {
      allow get:   if isAdmin();
      allow list:  if isAdmin() && request.query.limit <= 300;
      allow write: if false;
    }


    // =====================================================
    // /episodes/{episodeId} : ゲストから集めた思い出エピソード
    //   ミニAI の文脈と、オープニングムービーの素材になる。
    //
    //   ★visibleToTags で ABAC をかける★
    //     targetTags（誰についての話か）とは別のフィールド。
    //     兼務させると、限定公開のエピソードが
    //     他のゲストへの AI 回答に混ざる。
    //   書き込みは Route Handler (Admin SDK) 経由のみ。
    // =====================================================
    match /episodes/{episodeId} {
      allow get: if isAdmin()
        || (signedIn()
            && resource != null
            && resource.data.status == 'approved'
            && canSee(resource.data));

      allow list: if (isAdmin() && request.query.limit <= 500)
        || (signedIn()
            && request.query.limit <= 50
            && resource.data.status == 'approved'
            && canSee(resource.data));

      allow write: if false;
    }

    // =====================================================
    // /tags/{tagId} : 管理者が作ったカスタムタグの辞書
    //   ★ここにあるのは表示用の語彙（ラベルと色）だけ★
    //     権限そのものは Custom Claims の tags が持っているので、
    //     このコレクションが空でも組み込みタグは通常どおり動く。
    //   書き込みは Route Handler (Admin SDK) 経由のみ。
    // =====================================================
    match /tags/{tagId} {
      allow get:   if signedIn();
      allow list:  if signedIn() && request.query.limit <= 200;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
    // =====================================================
    // collectionGroup("comments") 用のルール
    //   ★上の match /posts/{postId}/comments/{id} は
    //     コレクショングループクエリには適用されない★
    //     /screen が全投稿横断でコメントを購読するために必要。
    //   ABAC は resource.data.visibleToTags で1件ずつ評価される。
    // =====================================================
    match /{path=**}/comments/{commentId} {
      allow list: if signedIn()
        && request.query.limit <= 100
        && (isAdmin() || canSee(resource.data));
    }

  }
}
